<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/wifi_camera_setup_help" />
        <EditText android:id="@+id/camera_ssid" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:hint="@string/wifi_camera_ssid" android:inputType="textNoSuggestions"
            android:singleLine="true" android:saveEnabled="false" android:importantForAutofill="no" />
        <Spinner android:id="@+id/camera_security" android:layout_width="match_parent"
            android:layout_height="48dp" android:entries="@array/wifi_camera_security"
            android:contentDescription="@string/wifi_camera_security_label" />
        <EditText android:id="@+id/camera_password" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:hint="@string/wifi_camera_password" android:inputType="textPassword"
            android:singleLine="true" android:saveEnabled="false" android:importantForAutofill="no" />
        <CheckBox android:id="@+id/camera_auto_connect" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/wifi_camera_auto_connect" />
    </LinearLayout>
</ScrollView>
